{
  "name": "erp-bakery-backend",
  "version": "1.0.0",
  "description": "ERP Bakery Backend API - NestJS + TypeScript + Raw SQL",
  "author": "",
  "license": "ISC",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "node node_modules/jest-cli/bin/jest.js --runInBand --forceExit",
    "test:watch": "node node_modules/jest-cli/bin/jest.js --watch --runInBand",
    "test:cov": "node node_modules/jest-cli/bin/jest.js --coverage --runInBand --forceExit",
    "migrate": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "migrate:test": "node-pg-migrate up -f config/database/test.json",
    "migrate:test:down": "node-pg-migrate down -f config/database/test.json",
    "seed": "ts-node -r tsconfig-paths/register src/Infrastructures/database/seeds/run-seed.ts",
    "regrant:produksi": "ts-node -r tsconfig-paths/register src/Infrastructures/database/seeds/regrant-produksi-permissions.ts",
    "smoke": "ts-node scripts/smoke-test.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "@fastify/multipart": "8.3.1",
    "@fastify/static": "^7.0.4",
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-fastify": "^10.3.0",
    "@nestjs/swagger": "^7.3.0",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "pg": "^8.11.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/testing": "^10.3.0",
    "@types/bcrypt": "^5.0.2",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.7",
    "@types/pg": "^8.11.5",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@typescript-eslint/parser": "^7.8.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "node-pg-migrate": "^7.5.2",
    "nodemon": "^3.1.0",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.5"
  }
}
