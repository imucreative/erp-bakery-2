# ─── HTTP Server ─────────────────────────────────────────────
HOST=0.0.0.0
PORT=3000

# ─── PostgreSQL (main) ───────────────────────────────────────
PGHOST=localhost
PGPORT=5435
PGUSER=postgres
PGPASSWORD=your_password
PGDATABASE=erp_bakery

# ─── PostgreSQL (test) ───────────────────────────────────────
PGHOST_TEST=localhost
PGPORT_TEST=5435
PGUSER_TEST=postgres
PGPASSWORD_TEST=your_password
PGDATABASE_TEST=erp_bakery_test

# ─── JWT ─────────────────────────────────────────────────────
ACCESS_TOKEN_SECRET=816e919145093e233b8ed2a256420d83b4940af15110ba1be82a9f360d5c044151bb551d2210b7b598a4dafd718d7681d6df99627493ccb3d279d5440986033e
REFRESH_TOKEN_SECRET=08add06804d52d7838b000bfd31f7e08c191cb8e8c7900a1b8593432e040582f96512e2a4f42a842adf94598afc91993cdffed550fcd6e3d9fa1c3c4ba3c46d8
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
# Longer refresh-token lifetime when the user checks "Keep me logged in".
REFRESH_TOKEN_REMEMBER_EXPIRES_IN=30d

# ─── App ─────────────────────────────────────────────────────
NODE_ENV=development
API_PREFIX=api/v1

# ─── node-pg-migrate ─────────────────────────────────────────
DATABASE_URL=postgresql://postgres:your_password@localhost:5435/erp_bakery

# ─── Seeder ──────────────────────────────────────────────────
SUPER_ADMIN_EMAIL=admin@erp.local
SUPER_ADMIN_PASSWORD=12345678
SUPER_ADMIN_NAME=Super Admin

# --- 2FA (TOTP) ---
# 64 hex chars (32 bytes): openssl rand -hex 32
TOTP_ENCRYPTION_KEY=
TWO_FACTOR_ISSUER=Bakery ERP
MFA_TOKEN_EXPIRES_IN=5m

# --- Reset password ("lupa password") ---
# URL frontend dipakai untuk menyusun tautan di email reset.
FRONTEND_URL=http://localhost:5174
# true = tautan reset ikut dikembalikan di response POST /auth/forgot-password.
# Hanya berlaku bila NODE_ENV != production (untuk pilot sebelum SMTP tersedia).
# Di produksi biarkan kosong/false dan kirim lewat email (MailSender).
AUTH_EXPOSE_RESET_LINK=false

CORS_ORIGIN=*
MFA_TOKEN_SECRET=816e919145093e233b8ed2a256420d83b4940af15110ba1be82a9f360d5c044151bb551d2210b7b598a4dafd718d7681d6df99627493ccb3d279d5440986033e
PGSSL=false
PGSSLMODE=false
SMOKE_BASE_URL=http://localhost:5000/api/v1
UPLOAD_ROOT=process.cwd()/uploads