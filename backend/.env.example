# ─── HTTP Server ─────────────────────────────────────────────
HOST=0.0.0.0
PORT=3000

# ─── PostgreSQL (main) ───────────────────────────────────────
PGHOST=localhost
PGPORT=5435
PGUSER=postgres
PGPASSWORD=your_password
PGDATABASE=erp_bakery

# ─── PostgreSQL (test) ───────────────────────────────────────
PGHOST_TEST=localhost
PGPORT_TEST=5435
PGUSER_TEST=postgres
PGPASSWORD_TEST=your_password
PGDATABASE_TEST=erp_bakery_test

# ─── JWT ─────────────────────────────────────────────────────
ACCESS_TOKEN_SECRET=your_access_token_secret
REFRESH_TOKEN_SECRET=your_refresh_token_secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ─── App ─────────────────────────────────────────────────────
NODE_ENV=development
API_PREFIX=api/v1

# ─── node-pg-migrate ─────────────────────────────────────────
DATABASE_URL=postgresql://postgres:your_password@localhost:5435/erp_bakery

# ─── Seeder ──────────────────────────────────────────────────
SUPER_ADMIN_EMAIL=admin@erp.local
SUPER_ADMIN_PASSWORD=12345678
SUPER_ADMIN_NAME=Super Admin

# --- 2FA (TOTP) ---
# 64 hex chars (32 bytes): openssl rand -hex 32
TOTP_ENCRYPTION_KEY=
TWO_FACTOR_ISSUER=Bakery ERP
MFA_TOKEN_EXPIRES_IN=5m

# --- Reset password ("lupa password") ---
# URL frontend dipakai untuk menyusun tautan di email reset.
FRONTEND_URL=http://localhost:5174
# true = tautan reset ikut dikembalikan di response POST /auth/forgot-password.
# Hanya berlaku bila NODE_ENV != production (untuk pilot sebelum SMTP tersedia).
# Di produksi biarkan kosong/false dan kirim lewat email (MailSender).
AUTH_EXPOSE_RESET_LINK=false
